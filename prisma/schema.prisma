// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String
  role         String   @default("ADMIN")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Project {
  id              String   @id @default(cuid())
  name            String
  slug            String   @unique
  summary         String
  highlights      String[]
  stack           String[]
  tone            String   @default("Platform")
  image           String
  liveClientUrl   String?
  liveServerUrl   String?
  githubClientUrl String?
  githubServerUrl String?
  featured        Boolean  @default(false)
  orderIndex      Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model SkillGroup {
  id         String   @id @default(cuid())
  title      String   @unique
  items      String[]
  orderIndex Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model Experience {
  id         String   @id @default(cuid())
  title      String
  period     String
  text       String
  highlights String[]
  featured   Boolean  @default(false)
  orderIndex Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model Education {
  id          String   @id @default(cuid())
  title       String
  institution String
  period      String
  summary     String
  highlights  String[]
  meta        String?
  orderIndex  Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Service {
  id          String   @id @default(cuid())
  title       String   @unique
  slug        String   @unique
  description String
  points      String[]
  price       String
  active      Boolean  @default(true)
  orderIndex  Int      @default(0)
  orders      Order[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

enum OrderStatus {
  PENDING
  REVIEWED
  QUOTED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

model Order {
  id              String      @id @default(cuid())
  trackingCode    String      @unique
  clientName      String
  clientEmail     String
  clientPhone     String
  serviceId       String?
  service         Service?    @relation(fields: [serviceId], references: [id], onDelete: SetNull)
  serviceTitle    String
  servicePrice    String
  servicePoints   String[]
  projectDetails  String?     @db.Text
  status          OrderStatus @default(PENDING)
  quotationAmount Float?
  quotationNotes  String?     @db.Text
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
}

model BlogPost {
  id          String    @id @default(cuid())
  title       String
  slug        String    @unique
  excerpt     String
  content     String    @db.Text
  coverImage  String?
  category    String    @default("General")
  readTime    String    @default("5 min read")
  published   Boolean   @default(false)
  publishedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model Testimonial {
  id         String   @id @default(cuid())
  clientName String
  role       String
  company    String?
  avatarUrl  String?
  content    String   @db.Text
  rating     Int      @default(5)
  featured   Boolean  @default(false)
  orderIndex Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model SiteSetting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String   @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

